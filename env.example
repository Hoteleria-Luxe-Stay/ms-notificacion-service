# ============================================================
# notificacion-service - DEV environment template
# ------------------------------------------------------------
# Copy this file to .env (in this same folder) and load it
# from your IDE Run Configuration (e.g. EnvFile plugin in IntelliJ).
# Defaults in YAML are PROD-safe; this file overrides for DEV.
# ============================================================

# --- Spring Cloud Config Server ---
CONFIG_IMPORT=optional:configserver:http://localhost:8888
CONFIG_FAIL_FAST=false

# --- Server ---
SERVER_PORT=8084

# --- Eureka discovery ---
EUREKA_URL=http://localhost:8761/eureka

# --- Datasource (MySQL) ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/notificacion_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- JPA (DEV verbose; YAML defaults are PROD-safe) ---
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# --- RabbitMQ (consumer of hotel.events + contacto exchange) ---
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=
SPRING_RABBITMQ_PASSWORD=

# --- Kafka (consumer of reserva.notifications) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Defaults in YAML; override only if needed
# KAFKA_NOTIFICATION_GROUP_ID=notificacion-service
# KAFKA_RESERVA_NOTIFICATIONS_TOPIC=reserva.notifications

# --- JWT (RSA public key validation) ---
# Same public key emitted by auth-service. PEM single-line with literal \n.
JWT_PUBLIC_KEY=

# --- Auth service (service-to-service via OAuth2 client_credentials) ---
# DEV: auth-service runs locally from IDE on port 8081
AUTH_SERVICE_URL=http://localhost:8081
# Must match NOTIFICACION_SERVICE_CLIENT_ID/SECRET seeded in auth-service
AUTH_SERVICE_CLIENT_ID=
AUTH_SERVICE_CLIENT_SECRET=

# --- Mail (SMTP) ---
# Gmail: enable 2-Step Verification and generate an App Password (16 chars).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Defaults to MAIL_USERNAME if empty
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=LuxeStay
MAIL_STARTTLS=true

# --- Soporte ---
# Destinatario de los mensajes de contacto
SUPPORT_EMAIL=

# --- CORS (DEV: Angular dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
